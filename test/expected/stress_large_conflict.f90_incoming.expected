module large_conflict_test
    implicit none
    private

    public :: process_array

contains

    ! Version A: Bubble sort implementation
    subroutine process_array(arr, n)
        integer, intent(in) :: n
        real, intent(inout) :: arr(n)
        integer :: i, j
        real :: temp
        logical :: swapped

        do i = 1, n-1
            swapped = .false.
            do j = 1, n-i
                if (arr(j) > arr(j+1)) then
                    temp = arr(j)
                    arr(j) = arr(j+1)
                    arr(j+1) = temp
                    swapped = .true.
                end if
            end do
            if (.not. swapped) exit
        end do

        ! Normalize array
        temp = maxval(arr)
        if (temp > 0.0) then
            arr = arr / temp
        end if

        ! Apply transformation
        do i = 1, n
            arr(i) = sqrt(abs(arr(i)))
        end do

end module large_conflict_test
